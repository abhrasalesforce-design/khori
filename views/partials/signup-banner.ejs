<%# Welcome sign-up banner: shown to logged-out visitors after 30s on the site.
    Offer text lives here; account creation is POST /register/quick (routes/auth.js). %>
<% const __offerPct = 10, __offerCode = 'HATHEKHORI10', __offerCap = 50; %>
<div id="hkSignup" class="hk-signup" role="dialog" aria-modal="true" aria-labelledby="hkSignupTitle" hidden>
  <div class="hk-signup-backdrop" data-close></div>
  <div class="hk-signup-card">
    <button type="button" class="hk-signup-x" aria-label="Close" data-close>✕</button>

    <div class="hk-signup-body" id="hkSignupForm">
      <img src="/icon-192.png" alt="" width="56" height="56" class="hk-signup-icon">
      <p class="hk-signup-eyebrow">Welcome offer</p>
      <h2 id="hkSignupTitle" class="hk-signup-title">Get <%= __offerPct %>% off your first order</h2>
      <p class="hk-signup-text">Create your free Hathekhori account to unlock <%= __offerPct %>% off your first handmade piece, plus early access to new arrivals.</p>

      <form novalidate>
        <input type="text" name="name" placeholder="Full name" autocomplete="name" required maxlength="100">
        <input type="email" name="email" placeholder="Email address" autocomplete="email" required maxlength="200">
        <input type="password" name="password" placeholder="Create a password (min 6 characters)" autocomplete="new-password" minlength="6" required>
        <p class="hk-signup-error" role="alert" hidden></p>
        <button type="submit" class="hk-signup-btn">Create account &amp; claim <%= __offerPct %>% off</button>
      </form>
      <p class="hk-signup-small">Already have an account? <a href="/login">Log in</a> · <button type="button" class="hk-signup-link" data-close>No thanks</button></p>
    </div>

    <div class="hk-signup-body" id="hkSignupDone" hidden>
      <img src="/icon-192.png" alt="" width="56" height="56" class="hk-signup-icon">
      <h2 class="hk-signup-title">Welcome, <span id="hkSignupName"></span>!</h2>
      <p class="hk-signup-text">Your account is ready and you're signed in. Here's your welcome code:</p>
      <div class="hk-coupon">
        <span class="hk-coupon-code" id="hkCouponCode"><%= __offerCode %></span>
        <button type="button" class="hk-coupon-copy" id="hkCouponCopy">Copy</button>
      </div>
      <p class="hk-signup-small" style="margin:0 0 18px;"><%= __offerPct %>% off your first order (up to ₹<%= __offerCap %>). Enter it in your cart or at checkout.</p>
      <button type="button" class="hk-signup-btn" id="hkSignupContinue">Continue shopping</button>
    </div>
  </div>
</div>

<style>
  .hk-signup[hidden] { display: none; }
  .hk-signup { position: fixed; inset: 0; z-index: 9500; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .hk-signup-backdrop { position: absolute; inset: 0; background: rgba(58,46,46,0.45); animation: hkFade .25s ease; }
  .hk-signup-card { position: relative; width: 100%; max-width: 430px; max-height: calc(100vh - 32px); overflow-y: auto; background: #fff; border-radius: 16px;
    border-top: 4px solid #898AC4; box-shadow: 0 18px 60px rgba(58,46,46,0.25); animation: hkRise .3s cubic-bezier(.2,.8,.3,1); }
  .hk-signup-body { padding: 34px 30px 26px; text-align: center; }
  .hk-signup-icon { display: block; margin: 0 auto 10px; border-radius: 50%; }
  .hk-signup-eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: #898AC4; margin-bottom: 6px; }
  .hk-signup-title { font-family: 'Playfair Display', Georgia, serif; font-size: 1.55rem; line-height: 1.25; color: #3a3a5c; margin: 0 0 10px; }
  .hk-signup-text { font-size: .88rem; line-height: 1.6; color: #6b6b8a; margin: 0 0 20px; }
  .hk-signup form { display: flex; flex-direction: column; gap: 10px; }
  .hk-signup input { width: 100%; padding: 12px 14px; border: 1px solid #e8dde3; border-radius: 8px; font-size: 16px; font-family: Inter, sans-serif; color: #3a3a5c; background: #fbfafd; outline: none; }
  .hk-signup input:focus { border-color: #898AC4; background: #fff; }
  .hk-signup-btn { width: 100%; margin-top: 4px; padding: 13px; border: none; border-radius: 8px; background: #898AC4; color: #fff; font-size: .88rem; font-weight: 600; letter-spacing: .03em; cursor: pointer; font-family: Inter, sans-serif; }
  .hk-signup-btn:hover { background: #7778b6; }
  .hk-signup-btn:disabled { opacity: .6; cursor: default; }
  .hk-signup-error { margin: 0; font-size: .8rem; color: #c0504d; text-align: left; }
  .hk-signup-small { margin: 16px 0 0; font-size: .78rem; color: #8a8aa3; }
  .hk-signup-small a { color: #898AC4; font-weight: 600; }
  .hk-signup-link { background: none; border: none; padding: 0; color: #8a8aa3; font-size: .78rem; text-decoration: underline; cursor: pointer; font-family: inherit; }
  .hk-coupon { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 0 auto 10px; max-width: 300px; padding: 10px 10px 10px 18px; border: 2px dashed #898AC4; border-radius: 10px; background: #f7f6fc; }
  .hk-coupon-code { font-family: 'Courier New', monospace; font-size: 1.25rem; font-weight: 700; letter-spacing: .12em; color: #3a3a5c; }
  .hk-coupon-copy { padding: 8px 14px; border: none; border-radius: 6px; background: #898AC4; color: #fff; font-size: .78rem; font-weight: 600; cursor: pointer; font-family: Inter, sans-serif; }
  .hk-signup-x { position: absolute; top: 10px; right: 12px; width: 34px; height: 34px; border: none; background: none; font-size: 1.1rem; color: #aaa; cursor: pointer; border-radius: 50%; }
  .hk-signup-x:hover { background: #f3f0f8; color: #3a3a5c; }
  @media (max-width: 520px) {
    .hk-signup { align-items: flex-end; padding: 0; }
    .hk-signup-card { max-width: none; border-radius: 16px 16px 0 0; max-height: 92vh; }
    .hk-signup-body { padding: 30px 20px 22px; }
  }
  @keyframes hkFade { from { opacity: 0; } }
  @keyframes hkRise { from { opacity: 0; transform: translateY(24px); } }
  @media (prefers-reduced-motion: reduce) { .hk-signup-backdrop, .hk-signup-card { animation: none; } }
</style>

<script>
(function () {
  var DELAY_S = 30;                       // seconds on the site before showing
  var SNOOZE_MS = 7 * 24 * 60 * 60 * 1000; // hidden for 7 days after "No thanks"
  var SKIP = /^\/(login|register|forgot-password|reset-password|checkout|order-confirmation|admin)/;
  var el = document.getElementById('hkSignup');
  if (!el || SKIP.test(location.pathname)) return;

  function get(store, k) { try { return window[store].getItem(k); } catch (e) { return null; } }
  function set(store, k, v) { try { window[store].setItem(k, v); } catch (e) {} }

  var snoozed = Number(get('localStorage', 'hkSignupSnooze') || 0);
  if (get('localStorage', 'hkSignupDone') || Date.now() - snoozed < SNOOZE_MS) return;

  // Count only time the page is actually visible, across pages in this visit
  var seconds = Number(get('sessionStorage', 'hkSignupSeconds') || 0);
  var lastFocus = null;
  var timer = setInterval(function () {
    if (document.visibilityState !== 'visible') return;
    seconds += 1; set('sessionStorage', 'hkSignupSeconds', seconds);
    if (seconds >= DELAY_S && !otherOverlayOpen()) { clearInterval(timer); open(); }
  }, 1000);

  function otherOverlayOpen() {
    var r = document.getElementById('reviewModal');
    return (r && r.style.display === 'flex') || document.body.classList.contains('menu-open');
  }

  function open() {
    lastFocus = document.activeElement;
    el.hidden = false;
    var first = el.querySelector('input[name=name]');
    setTimeout(function () { first && first.focus(); }, 50);
    document.addEventListener('keydown', onKey);
    if (window.gtag) gtag('event', 'view_promotion', { promotion_name: 'welcome_signup_banner' });
  }
  function close(snooze) {
    el.hidden = true;
    document.removeEventListener('keydown', onKey);
    if (snooze) set('localStorage', 'hkSignupSnooze', String(Date.now()));
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function onKey(e) { if (e.key === 'Escape') close(true); }
  el.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', function () { close(true); }); });

  var form = el.querySelector('form'), err = el.querySelector('.hk-signup-error'), btn = el.querySelector('.hk-signup-btn');
  function showError(msg, withLogin) {
    err.innerHTML = '';
    err.appendChild(document.createTextNode(msg + ' '));
    if (withLogin) { var a = document.createElement('a'); a.href = '/login'; a.textContent = 'Log in'; a.style.color = '#898AC4'; err.appendChild(a); }
    err.hidden = false;
  }
  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    err.hidden = true;
    var data = { name: form.name.value.trim(), email: form.email.value.trim(), password: form.password.value };
    if (!data.name || !data.email || !data.password) return showError('Please fill in all fields.');
    if (data.password.length < 6) return showError('Password must be at least 6 characters.');
    btn.disabled = true; var label = btn.textContent; btn.textContent = 'Creating your account…';
    try {
      var res = await fetch('/register/quick', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
        body: JSON.stringify(data)
      });
      var out = {}; try { out = await res.json(); } catch (_) {}
      if (!res.ok || !out.ok) throw Object.assign(new Error(out.error || (res.status === 429 ? 'Too many attempts. Please try again later.' : 'Something went wrong. Please try again.')), { login: out.login });
      set('localStorage', 'hkSignupDone', '1');
      if (window.gtag) gtag('event', 'sign_up', { method: 'welcome_banner' });
      document.getElementById('hkSignupName').textContent = out.name || data.name;
      document.getElementById('hkSignupForm').hidden = true;
      document.getElementById('hkSignupDone').hidden = false;
      document.getElementById('hkSignupContinue').focus();
    } catch (e2) {
      showError(e2.message, e2.login);
    } finally {
      btn.disabled = false; btn.textContent = label;
    }
  });
  document.getElementById('hkCouponCopy').addEventListener('click', function () {
    var b = this, code = document.getElementById('hkCouponCode').textContent.trim();
    function done() { b.textContent = 'Copied!'; setTimeout(function () { b.textContent = 'Copy'; }, 2000); }
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(done, function () { selectCode(); });
    else selectCode();
    function selectCode() { var r = document.createRange(); r.selectNodeContents(document.getElementById('hkCouponCode')); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }
  });
  // Reload so the header shows the signed-in menu
  document.getElementById('hkSignupContinue').addEventListener('click', function () { location.reload(); });
})();
</script>
