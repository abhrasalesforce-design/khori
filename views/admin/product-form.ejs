<%- include('../partials/header') %>

<div class="page-container">
  <h1><%= product ? 'Edit Product' : 'New Product' %></h1>
  <% if (error && error.length) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form method="POST" action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/new' %>" enctype="multipart/form-data" class="product-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-row">
      <label>Product Name *</label>
      <input type="text" name="name" value="<%= product ? product.name : '' %>" required>
    </div>

    <!-- Description with existing picker -->
    <div class="form-row">
      <label>Description</label>
      <% if (suggestions.descriptions.length > 0) { %>
        <div style="margin-bottom:6px;">
          <select id="descPicker" style="width:100%;padding:7px 12px;border:1px solid #e8dde3;border-radius:6px;font-size:0.82rem;color:#898AC4;font-family:'Inter',sans-serif;outline:none;background:#f9f7f7;">
            <option value="">— Copy from existing product description —</option>
            <% suggestions.descriptions.forEach(d => { %>
              <option value="<%= d.replace(/"/g, '&quot;') %>"><%= d.length > 80 ? d.substring(0,80)+'…' : d %></option>
            <% }) %>
          </select>
        </div>
      <% } %>
      <textarea name="description" id="descriptionField" rows="4"><%= product ? product.description : '' %></textarea>
      <div style="display:flex;align-items:center;gap:10px;margin-top:8px;">
        <button type="button" id="genDescBtn" style="padding:8px 16px;background:#898AC4;color:#fff;border:none;border-radius:6px;font-size:0.8rem;cursor:pointer;font-family:Inter,sans-serif;">✨ Generate Description</button>
        <span id="genDescStatus" style="font-size:0.78rem;color:#888;"></span>
      </div>
    </div>

    <div class="form-row two-col">
      <div>
        <label>Price (₹) *</label>
        <input type="number" name="price" value="<%= product ? product.price : '' %>" step="0.01" min="0" required>
      </div>
      <div>
        <label>Stock</label>
        <input type="number" name="stock" value="<%= product ? product.stock : '0' %>" min="0">
      </div>
    </div>

    <div class="form-row">
      <label>Category
        <a href="/admin/categories" target="_blank" style="font-size:0.75rem;color:#898AC4;margin-left:8px;text-decoration:none;">Manage categories →</a>
      </label>
      <select name="category">
        <option value="">— Select a category —</option>
        <% if (categoryTree && categoryTree.length) { %>
          <% categoryTree.forEach(parent => { %>
            <% if (parent.children && parent.children.length) { %>
              <optgroup label="<%= parent.name %>">
                <% parent.children.forEach(child => { %>
                  <option value="<%= child.slug %>" <%= product && product.category === child.slug ? 'selected' : '' %>><%= child.name %></option>
                <% }) %>
              </optgroup>
            <% } else { %>
              <option value="<%= parent.slug %>" <%= product && product.category === parent.slug ? 'selected' : '' %>><%= parent.name %></option>
            <% } %>
          <% }) %>
        <% } %>
      </select>
    </div>

    <div class="form-row">
      <label>Dimensions (L × B × H)</label>
      <div style="display:flex;align-items:center;gap:8px;">
        <input type="text" name="dim_l" placeholder="L" style="width:80px;" value="<%= product && product.dimension ? product.dimension.split('×')[0].trim() : '' %>">
        <span style="font-weight:600;font-size:1.1rem;">×</span>
        <input type="text" name="dim_b" placeholder="B" style="width:80px;" value="<%= product && product.dimension ? (product.dimension.split('×')[1]||'').trim() : '' %>">
        <span style="font-weight:600;font-size:1.1rem;">×</span>
        <input type="text" name="dim_h" placeholder="H" style="width:80px;" value="<%= product && product.dimension ? (product.dimension.split('×')[2]||'').trim() : '' %>">
      </div>
    </div>

    <!-- Material with datalist -->
    <div class="form-row">
      <label>Material</label>
      <input type="text" name="material" id="materialField"
        value="<%= product ? (product.material||'') : '' %>"
        placeholder="e.g. Terracotta, Brass, Cotton"
        list="materialsList" autocomplete="off">
      <datalist id="materialsList">
        <% suggestions.materials.forEach(m => { %><option value="<%= m %>"><% }) %>
      </datalist>
    </div>

    <!-- Craft Type with datalist -->
    <div class="form-row">
      <label>Craft Type</label>
      <input type="text" name="craft_type" id="craftTypeField"
        value="<%= product ? (product.craft_type||'') : '' %>"
        placeholder="e.g. Hand-painted, Block print, Woven"
        list="craftTypesList" autocomplete="off">
      <datalist id="craftTypesList">
        <% suggestions.craftTypes.forEach(c => { %><option value="<%= c %>"><% }) %>
      </datalist>
    </div>

    <!-- Origin with datalist -->
    <div class="form-row">
      <label>Origin</label>
      <input type="text" name="origin" id="originField"
        value="<%= product ? (product.origin||'') : '' %>"
        placeholder="e.g. West Bengal, Rajasthan"
        list="originsList" autocomplete="off">
      <datalist id="originsList">
        <% suggestions.origins.forEach(o => { %><option value="<%= o %>"><% }) %>
      </datalist>
    </div>

    <!-- Care Instructions with datalist -->
    <div class="form-row">
      <label>Care Instructions</label>
      <input type="text" name="care_instructions" id="careField"
        value="<%= product ? (product.care_instructions||'') : '' %>"
        placeholder="e.g. Wipe clean with dry cloth"
        list="careList" autocomplete="off">
      <datalist id="careList">
        <% suggestions.careInstructions.forEach(c => { %><option value="<%= c %>"><% }) %>
      </datalist>
    </div>

    <!-- Images -->
    <div class="form-row">
      <label>Product Images <span style="font-weight:400;color:#aaa;">(up to 10, first image = main)</span></label>
      <% if (product) {
           let existingImgs = [];
           try { existingImgs = product.images ? JSON.parse(product.images) : (product.image && product.image !== 'placeholder.jpg' ? [product.image] : []); } catch(e) {}
      %>
        <% if (existingImgs.length > 0) { %>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
          <% existingImgs.forEach((img, i) => { %>
            <div style="position:relative;display:inline-block;">
              <img src="<%= img.startsWith('http') ? img : '/uploads/' + img %>" width="72" height="72" style="object-fit:cover;border-radius:6px;border:1px solid #e8dde3;">
              <% if (i === 0) { %><span style="position:absolute;bottom:2px;left:2px;background:#898AC4;color:#fff;font-size:0.6rem;padding:1px 4px;border-radius:3px;">Main</span><% } %>
            </div>
          <% }) %>
        </div>
        <p style="font-size:0.75rem;color:#898AC4;margin:0 0 8px;">Uploading new images will replace all existing ones.</p>
        <% } %>
      <% } %>
      <input type="file" name="images" accept="image/*" multiple id="imagesInput">
      <div id="imgPreviewWrap" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;"></div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary"><%= product ? 'Save Changes' : 'Add Product' %></button>
      <a href="/admin" class="btn-outline">Cancel</a>
    </div>
  </form>
</div>

<script>
  // Copy selected description into textarea
  const descPicker = document.getElementById('descPicker');
  if (descPicker) {
    descPicker.addEventListener('change', function() {
      if (this.value) {
        document.getElementById('descriptionField').value = this.value;
        this.value = '';
      }
    });
  }

  // Image preview (order-stable)
  document.getElementById('imagesInput').addEventListener('change', function() {
    const wrap = document.getElementById('imgPreviewWrap');
    wrap.innerHTML = '';
    const files = Array.from(this.files);
    const slots = files.map((_, i) => {
      const div = document.createElement('div');
      div.style.cssText = 'position:relative;display:inline-block;width:72px;height:72px;background:#f5f0fb;border-radius:6px;';
      if (i === 0) div.innerHTML = '<span style="position:absolute;bottom:2px;left:2px;background:#898AC4;color:#fff;font-size:0.6rem;padding:1px 4px;border-radius:3px;z-index:1;">Main</span>';
      wrap.appendChild(div);
      return div;
    });
    files.forEach((file, i) => {
      const reader = new FileReader();
      reader.onload = e => {
        slots[i].insertAdjacentHTML('afterbegin', '<img src="' + e.target.result + '" style="width:72px;height:72px;object-fit:cover;border-radius:6px;border:1px solid #e8dde3;display:block;">');
      };
      reader.readAsDataURL(file);
    });
  });

  // Generate description via AI
  document.getElementById('genDescBtn').addEventListener('click', async function() {
    const btn = this;
    const status = document.getElementById('genDescStatus');
    btn.disabled = true; btn.textContent = 'Generating…'; status.textContent = '';
    const form = btn.closest('form');
    const data = new FormData();
    data.append('name', form.querySelector('[name=name]').value);
    data.append('category', form.querySelector('[name=category]').value);
    data.append('material', form.querySelector('[name=material]').value || '');
    data.append('origin', form.querySelector('[name=origin]').value || '');
    data.append('craft_type', form.querySelector('[name=craft_type]').value || '');
    const imageFile = form.querySelector('[name=images]').files[0];
    if (imageFile) data.append('image', imageFile);
    try {
      data.append('_csrf', document.querySelector('meta[name="csrf-token"]').content);
      const res = await fetch('/admin/generate-description', { method: 'POST', body: data });
      const json = await res.json();
      if (json.description) {
        document.getElementById('descriptionField').value = json.description;
        status.textContent = '✓ Done'; status.style.color = 'green';
      } else {
        status.textContent = json.error || 'Unknown error'; status.style.color = 'red';
      }
    } catch(e) {
      status.textContent = e.message || 'Network error'; status.style.color = 'red';
    }
    btn.disabled = false; btn.textContent = '✨ Generate Description';
  });
</script>

<%- include('../partials/footer') %>
