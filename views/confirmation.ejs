<%- include('partials/header') %>

<div class="page-container confirmation">
  <div class="confirm-icon">🌸</div>
  <h1>Order Placed!</h1>
  <p>Thank you, <strong><%= order.name %></strong>. Your order <strong>#<%= order.id %></strong> has been received.</p>

  <!-- Payment pending notice -->
  <div class="upi-confirm-box">
    <p>⏳ <strong>Your payment is being verified.</strong></p>
    <p>We'll confirm your order via <strong>WhatsApp</strong> on <strong><%= order.phone || 'the number you provided' %></strong> within <strong>2–3 hours</strong> of verifying your UPI transaction.</p>
    <% if (order.upi_txn_id) { %>
      <p style="margin-top:8px;">Transaction ID recorded: <code style="background:#f5f0fb;padding:2px 8px;border-radius:4px;color:#898AC4;font-size:0.9rem;"><%= order.upi_txn_id %></code></p>
    <% } %>
    <p style="margin-top:8px;font-size:0.85rem;color:#888;">Payments are processed between <strong>8:00 AM – 10:00 PM IST</strong>. Orders placed outside these hours will be confirmed the next morning.</p>
    <p style="margin-top:8px;font-size:0.85rem;color:#888;">Questions? Email us at <a href="mailto:contact.hathekhori@gmail.com" style="color:#898AC4;">contact.hathekhori@gmail.com</a></p>
  </div>

  <div class="order-items-summary">
    <h2>Items Ordered</h2>
    <% items.forEach(item => { %>
      <div class="confirm-item">
        <img src="<%= item.image && item.image.startsWith('http') ? item.image : '/uploads/' + item.image %>" alt="<%= item.product_name %>" onerror="this.src='/images/placeholder.jpg'">
        <span><%= item.product_name %> × <%= item.quantity %></span>
        <span>₹<%= (item.price * item.quantity).toFixed(2) %></span>
      </div>
    <% }) %>
    <div class="confirm-total"><strong>Total: ₹<%= order.total.toFixed(2) %></strong></div>
  </div>

  <p style="font-size:0.85rem;color:#898AC4;margin-bottom:20px;">Shipping to: <em><%= order.address %>, <%= order.city %>, <%= order.zip %>, <%= order.country %></em></p>

  <div class="confirm-actions">
    <a href="/orders" class="btn-primary">View My Orders</a>
    <a href="/" class="btn-outline">Continue Shopping</a>
  </div>
</div>

<%- include('partials/footer') %>
