<%- include('partials/header') %>

<div class="auth-container">
  <h1 style="color:#898AC4;">Change Password</h1>
  <p class="auth-subtitle" style="color:#898AC4;">Signed in as <%= user.email %></p>
  <% if (error && error.length) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success && success.length) { %><div class="alert alert-success"><%= success %></div><% } %>

  <form method="POST" action="/account/password" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="password" name="current_password" placeholder="Current password" autocomplete="current-password" required>
    <input type="password" name="password" placeholder="New password (min 6 characters)" autocomplete="new-password" required minlength="6">
    <input type="password" name="confirm_password" placeholder="Confirm new password" autocomplete="new-password" required minlength="6">
    <button type="submit" class="btn-primary" style="background:#898AC4;border-color:#898AC4;color:#fff;">Update Password</button>
  </form>
  <p class="auth-link" style="color:#898AC4;"><a href="<%= user.is_admin ? '/admin' : '/' %>" style="color:#898AC4;">← Back</a></p>
</div>

<%- include('partials/footer') %>
