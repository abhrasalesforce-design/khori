<%- include('partials/header') %>

<div class="auth-container">
  <h1 style="color:#898AC4;">Forgot Password</h1>
  <p class="auth-subtitle" style="color:#898AC4;">Enter your email and we'll send a reset link</p>
  <% if (error && error.length) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success && success.length) { %><div class="alert alert-success"><%= success %></div><% } %>

  <form method="POST" action="/forgot-password" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="email" name="email" placeholder="Email address" required>
    <button type="submit" class="btn-primary" style="background:#898AC4;border-color:#898AC4;color:#fff;">Send Reset Link</button>
  </form>
  <p class="auth-link" style="color:#898AC4;"><a href="/login" style="color:#898AC4;">← Back to Login</a></p>
</div>

<%- include('partials/footer') %>
