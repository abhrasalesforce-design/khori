<%- include('partials/header') %>

<div class="page-container">
  <h1>Checkout</h1>
  <div class="checkout-layout">
    <form id="checkout-form" method="POST" action="/checkout/place">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Shipping Details -->
      <div class="form-section">
        <h2>Shipping Details</h2>
        <div class="form-row">
          <input type="text" name="name" placeholder="Full Name" value="<%= user.name %>" required>
        </div>
        <div class="form-row">
          <input type="email" name="email" placeholder="Email" value="<%= user.email %>" required>
        </div>
        <div class="form-row">
          <input type="tel" name="phone" placeholder="WhatsApp Number (required for order confirmation)" required>
        </div>
        <div class="form-row">
          <input type="text" name="address" placeholder="Street Address" required>
        </div>
        <div class="form-row two-col">
          <input type="text" name="city" placeholder="City" required>
          <input type="text" name="zip" placeholder="ZIP / Postal Code" required>
        </div>
        <div class="form-row">
          <input type="text" name="country" placeholder="Country" required>
        </div>
      </div>

      <!-- Payment — UPI QR -->
      <div class="form-section">
        <h2>Payment</h2>

        <!-- Small business notice -->
        <div class="upi-notice">
          <p>🏪 <strong>We are a small, independent handmade crafts business.</strong> To keep things personal and secure for our customers, we currently accept payments via UPI rather than an automated payment gateway. This ensures every order is personally verified by us before processing.</p>
        </div>

        <!-- QR + instructions -->
        <div class="upi-payment-wrap">
          <div class="upi-qr-col">
            <p class="upi-qr-label">Scan to Pay</p>
            <img src="<%= (cdn && cdn['upi-qr.jpg']) || '/images/upi-qr.jpg' %>" alt="UPI QR Code" class="upi-qr-img" onerror="this.src='/images/upi-qr.jpg'">
            <p class="upi-amount">Amount: <strong>₹<%= total %></strong></p>
          </div>

          <div class="upi-steps-col">
            <h3 class="upi-steps-title">How to Pay</h3>
            <ol class="upi-steps">
              <li>Open GPay, PhonePe, Paytm or any UPI app</li>
              <li>Scan the QR code on the left</li>
              <li>Pay exactly <strong>₹<%= total %></strong></li>
              <li>Copy your <strong>Transaction ID / UTR number</strong> from the payment confirmation screen</li>
              <li>Paste it in the field below and place your order</li>
            </ol>

            <div class="upi-timing-box">
              <p>🕗 <strong>Payments accepted: 8:00 AM – 10:00 PM IST</strong></p>
              <p>⏱ Order confirmation will be shared via <strong>WhatsApp</strong> within 2–3 hours of payment verification.</p>
              <p>📧 For any queries: <a href="mailto:contact.hathekhori@gmail.com">contact.hathekhori@gmail.com</a></p>
            </div>
          </div>
        </div>

        <!-- Transaction ID + confirmation fields -->
        <div class="form-row" style="margin-top:20px;">
          <input type="text" name="upi_txn_id" placeholder="Transaction ID / UTR Number (e.g. 123456789012)" required>
        </div>
        <p class="upi-txn-hint">Find your Transaction ID in your UPI app under payment history after completing the payment.</p>

        <button type="submit" class="btn-primary upi-submit-btn">Place Order →</button>
      </div>
    </form>

    <div class="order-summary">
      <h2>Your Order</h2>
      <% items.forEach(item => { %>
        <div class="summary-item">
          <span><%= item.name %> × <%= item.quantity %></span>
          <span>₹<%= item.subtotal %></span>
        </div>
      <% }) %>
      <div class="summary-divider"></div>
      <div class="summary-item"><span>Subtotal</span><span>₹<%= subtotal %></span></div>
      <div class="summary-item"><span>Shipping</span><span><%= shipping === 0 ? 'Free' : '₹' + shipping %></span></div>
      <div class="summary-divider"></div>
      <div class="summary-total"><span>Total</span><span>₹<%= total %></span></div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
