<%- include('partials/header') %>

<div class="page-container">
  <h1>Checkout</h1>
  <div class="checkout-layout">

    <form id="checkout-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Shipping Details -->
      <div class="form-section">
        <h2>Shipping Details</h2>
        <div class="form-row">
          <input type="text" id="f-name" placeholder="Full Name" value="<%= user ? user.name : '' %>" required>
        </div>
        <div class="form-row">
          <input type="email" id="f-email" placeholder="Email" value="<%= user ? user.email : '' %>" required>
        </div>
        <div class="form-row">
          <input type="tel" id="f-phone" placeholder="Phone Number" required>
        </div>
        <div class="form-row">
          <input type="text" id="f-address" placeholder="Street Address" required>
        </div>
        <div class="form-row two-col">
          <input type="text" id="f-city" placeholder="City" required>
          <input type="text" id="f-zip" placeholder="ZIP / Postal Code" required>
        </div>
        <div class="form-row">
          <input type="text" id="f-country" placeholder="Country" value="India" required>
        </div>
      </div>

      <!-- Payment -->
      <div class="form-section">
        <h2>Payment</h2>
        <div class="rzp-summary">
          <p>You will be charged <strong>₹<%= total %></strong> via Razorpay.</p>
          <p style="font-size:0.8rem;color:#888;margin-top:6px;">Secure payment powered by Razorpay — UPI, cards, netbanking and wallets accepted.</p>
        </div>
        <p id="checkout-error" style="color:#e57373;font-size:0.85rem;display:none;margin-bottom:12px;"></p>
        <button type="button" id="pay-btn" class="btn-primary" style="width:100%;padding:14px;font-size:1rem;">
          Pay ₹<%= total %> →
        </button>
      </div>
    </form>

    <div class="order-summary">
      <h2>Your Order</h2>
      <% items.forEach(item => { %>
        <div class="summary-item">
          <span><%= item.name %> × <%= item.quantity %></span>
          <span>₹<%= item.subtotal %></span>
        </div>
      <% }) %>
      <div class="summary-divider"></div>
      <div class="summary-item"><span>Subtotal</span><span>₹<%= subtotal %></span></div>
      <div class="summary-item"><span>Shipping</span><span><%= shipping === 0 ? 'Free' : '₹' + shipping %></span></div>
      <div class="summary-divider"></div>
      <div class="summary-total"><span>Total</span><span>₹<%= total %></span></div>
    </div>

  </div>
</div>

<!-- Hidden form for final verified POST -->
<form id="place-order-form" method="POST" action="/checkout/place" style="display:none;">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="name" id="po-name">
  <input type="hidden" name="email" id="po-email">
  <input type="hidden" name="phone" id="po-phone">
  <input type="hidden" name="address" id="po-address">
  <input type="hidden" name="city" id="po-city">
  <input type="hidden" name="zip" id="po-zip">
  <input type="hidden" name="country" id="po-country">
  <input type="hidden" name="razorpay_order_id" id="po-rzp-order-id">
  <input type="hidden" name="razorpay_payment_id" id="po-rzp-payment-id">
  <input type="hidden" name="razorpay_signature" id="po-rzp-signature">
</form>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
document.getElementById('pay-btn').addEventListener('click', async function() {
  const btn = this;
  const errEl = document.getElementById('checkout-error');

  const name    = document.getElementById('f-name').value.trim();
  const email   = document.getElementById('f-email').value.trim();
  const phone   = document.getElementById('f-phone').value.trim();
  const address = document.getElementById('f-address').value.trim();
  const city    = document.getElementById('f-city').value.trim();
  const zip     = document.getElementById('f-zip').value.trim();
  const country = document.getElementById('f-country').value.trim();

  if (!name || !email || !phone || !address || !city || !zip || !country) {
    errEl.textContent = 'Please fill in all shipping details before paying.';
    errEl.style.display = 'block';
    return;
  }
  errEl.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Initialising…';

  try {
    const csrf = document.querySelector('meta[name="csrf-token"]').content;
    const res = await fetch('/checkout/create-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
      body: JSON.stringify({})
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to create order');

    const options = {
      key: '<%= razorpayKeyId %>',
      amount: data.amount,
      currency: data.currency,
      name: 'Hathekhori',
      description: 'Handmade Crafts',
      order_id: data.orderId,
      prefill: { name, email, contact: phone },
      theme: { color: '#898AC4' },
      handler: function(response) {
        // Payment successful — fill hidden form and submit for server-side verification
        document.getElementById('po-name').value    = name;
        document.getElementById('po-email').value   = email;
        document.getElementById('po-phone').value   = phone;
        document.getElementById('po-address').value = address;
        document.getElementById('po-city').value    = city;
        document.getElementById('po-zip').value     = zip;
        document.getElementById('po-country').value = country;
        document.getElementById('po-rzp-order-id').value   = response.razorpay_order_id;
        document.getElementById('po-rzp-payment-id').value = response.razorpay_payment_id;
        document.getElementById('po-rzp-signature').value  = response.razorpay_signature;
        document.getElementById('place-order-form').submit();
      },
      modal: {
        ondismiss: function() {
          btn.disabled = false;
          btn.textContent = 'Pay ₹<%= total %> →';
        }
      }
    };

    const rzp = new Razorpay(options);
    rzp.on('payment.failed', function(response) {
      errEl.textContent = 'Payment failed: ' + (response.error.description || 'Please try again.');
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Pay ₹<%= total %> →';
    });
    rzp.open();

  } catch(err) {
    errEl.textContent = err.message || 'Something went wrong. Please try again.';
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Pay ₹<%= total %> →';
  }
});
</script>

<%- include('partials/footer') %>
