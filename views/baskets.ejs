<%- include('partials/header') %>

<section class="basket-landing">
  <div class="basket-landing-inner">

    <!-- Hero -->
    <div class="basket-hero-wrap">
      <p class="basket-eyebrow">Handcrafted Gift Sets</p>
      <h1 class="basket-hero-title">Create Your Basket</h1>
      <p class="basket-hero-sub">Pick a combo, personalise it with your favourite pieces, and we'll wrap it all up beautifully.</p>
      <div class="basket-hero-badge">🧺 Add a gift basket to any combo for just <strong>₹50</strong></div>
    </div>

    <!-- Combo cards -->
    <div class="basket-card-grid">

      <a href="/baskets/kitty-keepsakes" class="basket-card">
        <div class="basket-card-accent" style="background: linear-gradient(135deg,#e8d5f0 0%,#d4c0e8 100%);"></div>
        <div class="basket-card-num">01</div>
        <div class="basket-card-icon-wrap">
          <span class="basket-card-icon">🎀</span>
        </div>
        <div class="basket-card-body">
          <h3>Kitty Keepsakes</h3>
          <p>A jewellery piece paired with a beautiful hand-crafted tote — the perfect duo for gifting.</p>
          <ul class="basket-card-includes">
            <li><span class="bci-chip">1 Jewellery</span></li>
            <li><span class="bci-chip">1 Tote Bag</span></li>
          </ul>
        </div>
        <div class="basket-card-footer">
          <span class="basket-optional-note">🧺 Basket add-on available</span>
          <span class="basket-card-cta">Customise <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </div>
      </a>

      <a href="/baskets/happy-parcel" class="basket-card">
        <div class="basket-card-accent" style="background: linear-gradient(135deg,#fde8d0 0%,#f5c9a0 100%);"></div>
        <div class="basket-card-num">02</div>
        <div class="basket-card-icon-wrap">
          <span class="basket-card-icon">🎁</span>
        </div>
        <div class="basket-card-body">
          <h3>Happy Parcel</h3>
          <p>A mini canvas artwork paired with a hand block keychain — cheerful, compact, and charming.</p>
          <ul class="basket-card-includes">
            <li><span class="bci-chip">1 Mini Canvas</span></li>
            <li><span class="bci-chip">1 Key Chain</span></li>
          </ul>
        </div>
        <div class="basket-card-footer">
          <span class="basket-optional-note">🧺 Basket add-on available</span>
          <span class="basket-card-cta">Customise <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </div>
      </a>

      <a href="/baskets/signature-gifting" class="basket-card basket-card--featured">
        <div class="basket-card-accent" style="background: linear-gradient(135deg,#898AC4 0%,#6a6ba8 100%);"></div>
        <div class="basket-card-num">03</div>
        <div class="basket-card-featured-badge">Most Popular</div>
        <div class="basket-card-icon-wrap">
          <span class="basket-card-icon">✨</span>
        </div>
        <div class="basket-card-body">
          <h3>Signature Gifting</h3>
          <p>Four hand block treasures curated into one signature gift — a complete gifting experience.</p>
          <ul class="basket-card-includes">
            <li><span class="bci-chip">1 Hand Block Diary</span></li>
            <li><span class="bci-chip">1 Diary Key Chain</span></li>
            <li><span class="bci-chip">1 Bookmark</span></li>
            <li><span class="bci-chip">1 Photo Frame</span></li>
          </ul>
        </div>
        <div class="basket-card-footer">
          <span class="basket-optional-note">🧺 Basket add-on available</span>
          <span class="basket-card-cta">Customise <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </div>
      </a>

      <a href="/baskets/artisan-combo" class="basket-card">
        <div class="basket-card-accent" style="background: linear-gradient(135deg,#d0e8d8 0%,#a8d0b4 100%);"></div>
        <div class="basket-card-num">04</div>
        <div class="basket-card-icon-wrap">
          <span class="basket-card-icon">🎨</span>
        </div>
        <div class="basket-card-body">
          <h3>Artisan Combo</h3>
          <p>Create your own mini gallery set — pick 2 to 3 round MDF art pieces you love.</p>
          <ul class="basket-card-includes">
            <li><span class="bci-chip">2–3 Round MDF Art</span></li>
          </ul>
        </div>
        <div class="basket-card-footer">
          <span class="basket-optional-note">🧺 Basket add-on available</span>
          <span class="basket-card-cta">Customise <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </div>
      </a>

    </div>

    <!-- Bottom trust strip -->
    <div class="basket-trust-strip">
      <span>🎁 Handpicked products</span>
      <span>✦</span>
      <span>🧺 Optional gift wrapping</span>
      <span>✦</span>
      <span>🚚 Free shipping above ₹699</span>
      <span>✦</span>
      <span>🤍 Made with love</span>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
