<%- include('partials/header') %>

<section class="basket-landing">
  <div class="basket-landing-inner">

    <!-- Hero -->
    <p class="basket-eyebrow">Handcrafted Gift Sets</p>
    <h1 class="basket-hero-title">Create Your Basket</h1>
    <p class="basket-hero-sub">Pick a combo, personalise it with your favourite pieces, and we'll wrap it all up beautifully. Add an optional handcrafted gift basket for just ₹50.</p>

    <!-- Combo cards -->
    <div class="basket-card-grid">

      <a href="/baskets/kitty-keepsakes" class="basket-card">
        <div class="basket-card-icon">🎀</div>
        <div class="basket-card-body">
          <h3>Kitty Keepsakes</h3>
          <p>A jewellery piece paired with a beautiful hand-crafted tote bag.</p>
          <ul class="basket-card-includes">
            <li>1 × Jewellery</li>
            <li>1 × Tote Bag</li>
            <li class="basket-card-optional">+ Optional Gift Basket (₹50)</li>
          </ul>
        </div>
        <span class="basket-card-cta">Customise →</span>
      </a>

      <a href="/baskets/happy-parcel" class="basket-card">
        <div class="basket-card-icon">🎁</div>
        <div class="basket-card-body">
          <h3>Happy Parcel</h3>
          <p>A mini canvas artwork paired with a hand block keychain.</p>
          <ul class="basket-card-includes">
            <li>1 × Mini Canvas</li>
            <li>1 × Key Chain</li>
            <li class="basket-card-optional">+ Optional Gift Basket (₹50)</li>
          </ul>
        </div>
        <span class="basket-card-cta">Customise →</span>
      </a>

      <a href="/baskets/signature-gifting" class="basket-card">
        <div class="basket-card-icon">✨</div>
        <div class="basket-card-body">
          <h3>Signature Gifting</h3>
          <p>Four hand block treasures curated into one signature gift set.</p>
          <ul class="basket-card-includes">
            <li>1 × Hand Block Diary</li>
            <li>1 × Diary Key Chain</li>
            <li>1 × Bookmark</li>
            <li>1 × Photo Frame</li>
            <li class="basket-card-optional">+ Optional Gift Basket (₹50)</li>
          </ul>
        </div>
        <span class="basket-card-cta">Customise →</span>
      </a>

      <a href="/baskets/artisan-combo" class="basket-card">
        <div class="basket-card-icon">🎨</div>
        <div class="basket-card-body">
          <h3>Artisan Combo</h3>
          <p>Create your own mini gallery set with round MDF art pieces.</p>
          <ul class="basket-card-includes">
            <li>2–3 × Round MDF Art Pieces</li>
            <li class="basket-card-optional">+ Optional Gift Basket (₹50)</li>
          </ul>
        </div>
        <span class="basket-card-cta">Customise →</span>
      </a>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
