<%- include('partials/header') %>

<div class="page-container">
  <h1>Your Cart</h1>

  <% if (items.length === 0) { %>
    <div class="empty-cart">
      <p>Your cart is empty.</p>
      <a href="/" class="btn-primary">Continue Shopping</a>
    </div>
  <% } else { %>
    <div class="cart-layout">
      <div class="cart-items">
        <% items.forEach(item => { %>
          <div class="cart-item">
            <img src="<%= item.image && item.image.startsWith('http') ? item.image : '/uploads/' + item.image %>" alt="<%= item.name %>" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg'">
            <div class="cart-item-info">
              <h3><a href="/product/<%= item.id %>"><%= item.name %></a></h3>
              <% if (item.inCombo && item.comboQty === item.quantity) { %>
                <p>₹<%= item.comboUnitPrice %> each <span style="font-size:0.75rem;color:#898AC4;background:#f3f2fa;padding:2px 7px;border-radius:10px;">Combo ₹259</span></p>
              <% } else if (item.inCombo) { %>
                <p>
                  <%= item.comboQty %> × ₹<%= item.comboUnitPrice %> <span style="font-size:0.75rem;color:#898AC4;background:#f3f2fa;padding:2px 7px;border-radius:10px;">Combo ₹259</span>
                  <% if (item.nonComboQty > 0) { %>+ <%= item.nonComboQty %> × ₹<%= item.normalPrice %><% } %>
                </p>
              <% } else { %>
                <p>₹<%= item.discountedPrice %> each</p>
              <% } %>
            </div>
            <div class="cart-subtotal">₹<%= item.subtotal %></div>
            <div class="cart-item-actions">
              <form method="POST" action="/cart/update" class="qty-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="product_id" value="<%= item.id %>">
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.stock %>">
                <button type="submit">Update</button>
              </form>
            </div>
            <div class="cart-item-remove">
              <form method="POST" action="/cart/remove">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="product_id" value="<%= item.id %>">
                <button type="submit" class="btn-remove">✕ Remove</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="cart-summary">
        <h2>Order Summary</h2>
        <div class="summary-row"><span>Subtotal</span><span>₹<%= subtotal %></span></div>
        <div class="summary-row"><span>Shipping</span><span><%= shipping === 0 ? 'Free' : '₹' + shipping %></span></div>
        <div class="summary-row total-row"><span>Total</span><span>₹<%= total %></span></div>
        <% if (user) { %>
          <a href="/checkout" class="btn-primary full-width">Proceed to Checkout</a>
        <% } else { %>
          <a href="/login" class="btn-primary full-width">Login to Checkout</a>
        <% } %>
        <a href="/" class="btn-outline full-width">Continue Shopping</a>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
